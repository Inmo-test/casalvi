# -----------------------------------------------------------------------------
# Casalvi — variables de entorno
# Copia este archivo a `.env.local` y rellena.
# Para modo local-first, usa los valores de `docker-compose.yml` (Supabase self-hosted).
# -----------------------------------------------------------------------------

# --- Supabase (obligatorio) ---
# Local (docker compose): http://localhost:54321
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321

# --- Proveedor IA ---
# Valores: "openai" (por defecto) | "ollama"
AI_PROVIDER=openai

# OpenAI (si AI_PROVIDER=openai)
OPENAI_API_KEY=sk-xxx
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small

# Ollama local (si AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBEDDINGS_MODEL=nomic-embed-text

# --- Transcripción de audio (opcional) ---
GROQ_API_KEY=

# --- Ingesta local ---
# Carpeta que el watcher vigila para indexar PDFs/docs/imágenes
INGEST_WATCH_DIR=/Users/you/Documents/Inmobiliaria

# --- URL pública ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

NODE_ENV=development
